# Local development only (`wrangler dev` reads .dev.vars, not .env).
# In production these live in the Cloudflare dashboard:
#   Workers & Pages → ideal-management → Settings → Variables and Secrets
# Changes there apply immediately — no redeploy.
#
# Copy this to .dev.vars for local work.

# Required, as a Secret. https://openrouter.ai/keys
# OPENROUTER_KEY is accepted as an alias if that is the name you reached for.
OPENROUTER_API_KEY=

# Optional. Comma-separated model ids, tried in order. Two from *different*
# providers is the point: free capacity is shared and gets busy, and the second
# is what rides through a 429.
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# Required to open /admin at all. Without it the page refuses to serve.
ADMIN_PASSWORD=

# Optional. Set it and submissions are emailed as well as stored.
RESEND_API_KEY=
NOTIFY_EMAIL=imanagement19@gmail.com
NOTIFY_FROM=

# Optional. Point the model calls at a proxy or a stand-in endpoint.
OPENROUTER_BASE_URL=
