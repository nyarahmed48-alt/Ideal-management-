{
  // Ideal Management — one Worker serving the site and its four API routes.
  //
  // There is no build step. `public/` ships as written and the Worker handles
  // /api/* and /admin. Connect this repository in the Cloudflare dashboard
  // (Workers & Pages → Import a repository) and every push to main deploys.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideal-management",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-13",

  // Give the Worker a URL. Without this a deploy can succeed and still be
  // unreachable — the dashboard shows "No URLs enabled" and there is nothing
  // to visit, which looks exactly like a broken deploy. Replaced by a custom
  // domain later; harmless to leave on alongside one.
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Anything that is not a file gets the 404 page rather than the homepage:
    // this is a set of real pages, not a single-page app.
    "not_found_handling": "404-page",
    // Static files are served without waking the Worker, except these — where
    // the Worker is the whole point.
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },

  // Form submissions and the CVs attached to them.
  //
  // Deliberately left out of the first deploy: a binding pointing at a resource
  // in the wrong account fails the whole deploy, and the site plus Ideal AI do
  // not need it. Get those live first, then switch the forms on.
  //
  // To switch them on: Storage & Databases → KV → Create a namespace, copy its
  // ID, uncomment the block below, paste it in, and push.
  //
  // "kv_namespaces": [
  //   { "binding": "SUBMISSIONS", "id": "PASTE_YOUR_KV_NAMESPACE_ID_HERE" }
  // ],
  //
  // If R2 is ever enabled, add an UPLOADS bucket binding as well and files go
  // there instead of KV — a config change, not a code one.

  // Plain variables, editable in the dashboard and live immediately — no
  // redeploy, which is the whole reason for moving off the previous host.
  // The API key is NOT here: it is a Secret, set in the dashboard or with
  // `wrangler secret put OPENROUTER_API_KEY`, so it never sits in the repo.
  "vars": {
    "OPENROUTER_MODEL": "poolside/laguna-xs-2.1:free"
  },

  "observability": {
    "enabled": true
  }
}
